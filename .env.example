APP_NAME="LaundryKu"
APP_ENV=development
APP_DEBUG=true
APP_URL="http://localhost/rpl/public"
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketplace_laundry
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://localhost/rpl/public/auth/google/callback"

APP_TIMEZONE="Asia/Jakarta"
PAYMENT_GATEWAY="mock_gateway"
PAYMENT_MOCK_SECRET="mock_secret_key_laundry_2026_xyz"
GOOGLE_MAPS_API_KEY=""

# AI Assistant Configuration (Gemini API)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
AI_PROVIDER="mock" # Set to "gemini" in production, or "mock" for testing/offline
AI_MODEL="gemini-3.5-flash-lite"
AI_RATE_LIMIT_PER_HOUR=20

# WhatsApp Gateway Configuration (Fonnte API)
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=fonnte # Options: fonnte, cloud_api, generic_gateway, mock
WHATSAPP_API_URL="https://api.fonnte.com/send"
WHATSAPP_API_TOKEN="YOUR_FONNTE_DEVICE_TOKEN_HERE"
WHATSAPP_MAX_RETRIES=3
WHATSAPP_TIMEOUT=30
